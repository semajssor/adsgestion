---
import "../styles/_header.scss";
import { useState } from "react";
// import { CONTACT_INFO } from "../constants.js";

const navLinks = [
	{ title: "Accueil", href: "/" },
	{ title: "À Propos", href: "/a-propos" },
	{ title: "Contactez-nous", href: "/contact" },
	{ title: "Ressources", href: "/ressources" },
];
---

<header class="main-header">
	<div class="header-container">
		<a href="/" class="logo" aria-label="Accueil Audrey Samson - Conseils fortune">
			<img src="/adsgf.png" alt="Logo ADS Gestion Financière" width="150" height="auto" />
		</a>

		<nav class="main-nav">
			<ul class="nav-list">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} aria-label={`Aller à la page ${link.title}`}>
								{link.title}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- <a
			href={CONTACT_INFO.bookingUrl}
			class="cta-button"
			rel="noopener noreferrer"
			onclick="gtag('event', 'generate_lead', {'event_category': 'Contact', 'event_label': 'Bouton RDV Outlook', 'transport_type': 'beacon'});">
			Contactez-nous
		</a> -->

		<button id="menu-toggle" class="menu-toggle" aria-label="Ouvrir le menu de navigation">
			<span class="hamburger-icon"></span>
		</button>
	</div>
</header>

<script>
	// On écoute l'événement d'Astro pour réinitialiser le script à chaque changement de page
	document.addEventListener("astro:page-load", () => {
		const toggleButton = document.getElementById("menu-toggle");
		const nav = document.querySelector(".main-nav");
		const body = document.body;

		// Optionnel : s'assurer que le menu se ferme automatiquement lors du changement de page
		if (nav && toggleButton) {
			nav.classList.remove("is-open");
			toggleButton.classList.remove("is-open");
			body.classList.remove("menu-active");
		}

		if (toggleButton && nav) {
			toggleButton.addEventListener("click", () => {
				nav.classList.toggle("is-open");
				toggleButton.classList.toggle("is-open");
				// Empêche le défilement du body lorsque le menu est ouvert
				body.classList.toggle("menu-active");
			});
		}
	});
</script>
