---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResourceCard from "../components/ResourceCard.astro";

const resources = [
	{
		title: "Assurance Collective vs Individuelle",
		description: "Explications claires sur l’assurance collective et individuelle.",
		fileUrl: "/resources/ass. collective vs ass. individuelle.pdf",
	},
	{
		title: "Budget - Entreprise",
		description: "Modèle Excel pour gérer le budget de votre entreprise.",
		fileUrl: "/resources/BUDGET - Entreprise.xlsx",
	},
	{
		title: "Budget - Personnel",
		description: "Feuille de calcul pour organiser vos finances personnelles.",
		fileUrl: "/resources/BUDGET - Personnel.xlsx",
	},
	{
		title: "Budget - Pros de la beauté",
		description: "Budget simplifié pour les professionnels de la beauté.",
		fileUrl: "/resources/BUDGET - Pros de la beauté.xlsx",
	},
];
---

<BaseLayout
	title="Ressources | Audrey Samson - Conseils fortune"
	description="Téléchargez nos guides et outils pour travailleurs autonomes et professionnels de la beauté.">
	<main class="resources-page">
		<h1>Ressources à télécharger</h1>
		<div class="resources-grid">
			{
				resources.map((r) => (
					<ResourceCard title={r.title} description={r.description} fileUrl={r.fileUrl} />
				))
			}
		</div>
	</main>
</BaseLayout>

<script>
	// On définit une interface pour que TS sache que gtag existe sur window
	interface Window {
		gtag?: (...args: any[]) => void;
	}

	const trackDownloads = () => {
		const resourceLinks = document.querySelectorAll(".resources-grid a");

		resourceLinks.forEach((link) => {
			link.addEventListener("click", (e) => {
				// On précise à TS que la cible est bien un lien (HTMLAnchorElement)
				const target = e.currentTarget as HTMLAnchorElement;

				if (!target) return;

				const fileName = target.getAttribute("href") || "unknown";
				const fileTitle = target.querySelector("h2")?.innerText || fileName;

				// On vérifie window.gtag de façon sécurisée
				const globalWindow = window as unknown as Window;
				if (globalWindow.gtag) {
					globalWindow.gtag("event", "file_download", {
						"file_name": fileName,
						"file_extension": fileName.split(".").pop(),
						"event_label": `Téléchargement: ${fileTitle}`,
					});
				}
			});
		});
	};

	trackDownloads();
</script>
