---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/_home.scss";
import CtaSection from "../components/CtaSection";
import { CONTACT_INFO } from "../constants.js";
---

<BaseLayout
	title="Audrey Samson - Conseils fortune"
	description="Votre partenaire financier dédié aux travailleurs autonomes et professionnels de la beauté. Expertise et services personnalisés.">
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-content">
				<h1>Simplifiez vos finances, concentrez-vous sur votre métier</h1>
				<p>
					Chez <strong>Audrey Samson - Conseils fortune</strong>, nous accompagnons les travailleurs
					autonomes et professionnels de la beauté avec des services clairs, personnalisés et
					adaptés à vos besoins.
				</p>
				<!-- <a
					href={CONTACT_INFO.bookingUrl}
					class="cta-button"
					target="_blank"
					rel="noopener noreferrer"
					onclick="gtag('event', 'generate_lead', {'event_category': 'Contact', 'event_label': 'Bouton RDV Outlook', 'transport_type': 'beacon'});">
					Planifiez une consultation gratuite
				</a> -->
				<CtaSection
					title="Prêt à simplifier vos finances ?"
					buttonText="Contactez-nous dès aujourd’hui"
					buttonLink="/contact"
				/>
			</div>
		</section>

		<!-- Services Section -->
		<section class="services">
			<h2>Nos Services</h2>
			<div class="services-grid">
				<div class="service-card">
					<h3>Comptabilité & Fiscalité</h3>
					<p>
						Optimisez vos déclarations et simplifiez la gestion de vos finances professionnelles.
					</p>
				</div>
				<div class="service-card">
					<h3>Conseils Financiers</h3>
					<p>
						Profitez d’un accompagnement personnalisé pour atteindre vos objectifs à long terme.
					</p>
				</div>
				<div class="service-card">
					<h3>Ressources & Outils</h3>
					<p>
						Accédez à des guides et astuces pratiques pour mieux gérer vos revenus et vos dépenses.
					</p>
				</div>
			</div>
		</section>

		<!-- Call To Action -->
		<CtaSection
			title="Prêt à simplifier vos finances ?"
			buttonText="Contactez-nous dès aujourd’hui"
			buttonLink="/contact"
		/>
	</main>
</BaseLayout>
