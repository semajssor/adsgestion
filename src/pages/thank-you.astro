---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/_thank-you.scss";
import ConfettiEffect from "../components/ConfettiEffect.jsx";
---

<BaseLayout title="Merci ! | ADS Gestion Financière">
	<main class="page-thank-you">
		<!-- <ConfettiEffect client:load /> -->

		<section>
			<h1>Merci pour votre confiance !</h1>
			<p>
				Votre demande a été reçue avec succès. Un membre de l'équipe d'Audrey Samson vous contactera
				par téléphone ou par courriel d'ici les <strong>24 prochaines heures ouvrables</strong>.
			</p>

			<hr />

			<div class="actions-container">
				<div class="action-item">
					<p><strong>Vous ne voulez pas attendre ?</strong></p>
					<p>Réservez une plage horaire :</p>
					<a
						href="https://calendly.com/adsgestion-planifionsvotreavenirensemble"
						class="cta-button primary">
						Prendre rendez-vous maintenant
					</a>
				</div>

				<div class="action-item">
					<p>Vous pouvez également :</p>
					<br />
					<a href="/" class="cta-button secondary">Retour au site</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
