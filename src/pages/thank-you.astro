---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/_thank-you.scss";
// import ConfettiEffect from "../components/ConfettiEffect.jsx";
---

<BaseLayout title="Merci ! | Audrey Samson - Conseils fortune">
	<main class="page-thank-you">
		<!-- <ConfettiEffect client:load /> -->

		<section>
			<h1>Merci pour votre confiance !</h1>
			<p>
				Votre demande a été reçue avec succès. Un membre de l'équipe d'Audrey Samson vous contactera par téléphone ou par courriel d'ici les <strong>24 prochaines heures ouvrables</strong>.
			</p>
			<p>Vous pouvez également visiter notre site pour découvrir nos services :</p>
			<a href="/" class="cta-button">Retour au site</a>
		</section>
	</main>
</BaseLayout>
