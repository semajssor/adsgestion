<BaseLayout title="Vidéo | Audrey Samson - Conseils fortune">
	<main class="page-video">
		<section>
			<h1>Ça vous intéresse ?</h1>

			<div class="video">
				<div class="video-grid">
					<div class="video-card">
						<div class="video-wrapper">
							<video src={videoUrl} controls playsinline preload="metadata">
								Votre navigateur ne prend pas en charge la lecture de vidéos.
							</video>
						</div>
						<p>Découvrez notre approche en gestion financière</p>
						<a href="/rendez-vous" class="cta-button">Prendre rendez-vous</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
