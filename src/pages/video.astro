	"https://amfrjt6tcekku3bu.private.blob.vercel-storage.com/Pubsiteweb.format%20vertical.mov?vercel-blob-delegation=eyJzdG9yZUlkIjoic3RvcmVfYU1GUkpUNlRDZUtrdTNCdSIsIm93bmVySWQiOiJ0ZWFtX0tiN1N5Q1N2TVd2QlNER1RWVmlxMXh3TiIsInBhdGhuYW1lIjoiKiIsIm9wZXJhdGlvbnMiOlsiZ2V0IiwiaGVhZCJdLCJ2YWxpZFVudGlsIjoxNzkwNjQwOTk3NTg2LCJpYXQiOjE3OTA1OTc3OTc3NjF9.RGtu5teIDjPUGVGeArQcsHpuV1Ua9VXt5ruOd7OPLdY&vercel-blob-signature=S_ownTa0x70kcjwIjYrSXdsMebldEv-IoV47QUEjU90";
---

<BaseLayout title="Vidéo | Audrey Samson - Conseils fortune">
	<main class="page-video">
		<section>
			<h1>Ça vous intéresse ?</h1>

			<div class="video">
				<div class="video-grid">
					<div class="video-card">
						<div class="video-wrapper">
							<video src={videoUrl} autoplay muted loop playsinline controls preload="metadata">
								Votre navigateur ne prend pas en charge la lecture de vidéos.
							</video>
						</div>
						<p>Découvrez notre approche en gestion financière</p>
						<a href="/rendez-vous" class="cta-button" target="_blank" rel="noopener noreferrer"
							>Prendre rendez-vous</a
						>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
