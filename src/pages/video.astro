---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResourceCard from "../components/ResourceCard.astro";
import { resources } from "../data/resources.js";
import "../styles/_video.scss";

// URL de Booking direct pour Appel Exploratoire
const appelExploratoireUrl =
	"https://bookings.cloud.microsoft/book/ConseilsFortune@conseilsfortune.onmicrosoft.com/s/nWNraLp860KGoUMc6UW5YQ2?ismsaljsauthenabled=true";

// Sélection des ressources
const selectedIds = ["credit-qc", "assurance"];
const selectedResources = resources.filter((r) => selectedIds.includes(r.id));
---

<BaseLayout title="Vidéo | Audrey Samson - Conseils fortune">
	<main class="page-video">
		<section>
			<h1>Ça vous intéresse ?</h1>

			<div class="video">
				<div class="video-grid">
					<div class="video-card">
						<div class="video-wrapper">
							<!-- Conteneur ciblé par l'API JavaScript YouTube -->
							<div id="youtube-player"></div>
						</div>
						<p>Découvrez notre approche en gestion financière</p>
						<a
							href={appelExploratoireUrl}
							class="cta-button"
							target="_blank"
							rel="noopener noreferrer">Prendre rendez-vous</a
						>
					</div>
				</div>
			</div>

			<!-- Section des ressources sous la vidéo -->
			<div class="resources-section">
				<h2>Ressources recommandées</h2>
				<div class="resources-grid">
					{
						selectedResources.map((r) => (
							<ResourceCard title={r.title} description={r.description} fileUrl={r.fileUrl} />
						))
					}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	interface Window {
		gtag?: (...args: any[]) => void;
		YT?: any;
		onYouTubeIframeAPIReady?: () => void;
	}

	const initPage = () => {
		// 1. Suivi des téléchargements
		const resourceLinks = document.querySelectorAll(".resources-grid a");

		resourceLinks.forEach((link) => {
			link.addEventListener("click", (e) => {
				const target = e.currentTarget as HTMLAnchorElement;
				if (!target) return;

				const fileName = target.getAttribute("href") || "unknown";
				const fileTitle = target.querySelector("h3, h2")?.innerText || fileName;

				const globalWindow = window as unknown as Window;
				if (globalWindow.gtag) {
					globalWindow.gtag("event", "file_download", {
						"file_name": fileName,
						"file_extension": fileName.split(".").pop(),
						"event_label": `Téléchargement: ${fileTitle}`,
					});
				}
			});
		});

		// 2. Initialisation du lecteur YouTube
		const playerContainer = document.getElementById("youtube-player");
		if (!playerContainer) return;

		const createPlayer = () => {
			const globalWindow = window as unknown as Window;
			if (globalWindow.YT && globalWindow.YT.Player) {
				new globalWindow.YT.Player("youtube-player", {
					videoId: "6WDqStCBcyw",
					playerVars: {
						autoplay: 1,
						mute: 1,
						loop: 1,
						playlist: "6WDqStCBcyw",
						rel: 0,
						modestbranding: 1,
						playsinline: 1,
					},
					events: {
						onReady: (event: any) => {
							event.target.playVideo();
						},
					},
				});
			}
		};

		const globalWindow = window as unknown as Window;

		if (!globalWindow.YT) {
			// Charger l'API si elle n'est pas déjà présente
			const tag = document.createElement("script");
			tag.src = "https://www.youtube.com/iframe_api";
			const firstScriptTag = document.getElementsByTagName("script")[0];
			firstScriptTag.parentNode?.insertBefore(tag, firstScriptTag);

			globalWindow.onYouTubeIframeAPIReady = createPlayer;
		} else {
			// Si l'API est déjà chargée (ex: navigation SPA)
			createPlayer();
		}
	};

	// Exécution au chargement initial et lors des navigations Astro
	document.addEventListener("DOMContentLoaded", initPage);
	document.addEventListener("astro:page-load", initPage);
</script>
